#!/bin/sh
# CoalMine pre-commit hook (Unix)
# Generated by CoalMine
# Exit on failure to prevent commit

if [ -f scripts/verify.mjs ]; then
  # Single guarded node-test gate (existsSync precheck + orphan check + fail-loud);
  # scripts/test.mjs owns the test list so CI and the hooks cannot drift apart.
  node scripts/test.mjs || exit 1
  # PowerShell parity tests (shared ps-config + the spawned rot-canary PS hooks) — skip
  # if pwsh is absent so the gate still runs on a box without PowerShell; fail loud when present.
  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File scripts/lib/ps-config.test.ps1 || exit 1
    pwsh -NoProfile -File scripts/lib/ps-hooks.test.ps1 || exit 1
  else
    # gold-standard 2026-08-18/19 F12: this used to skip SILENTLY -- that silence
    # masked 4 consecutive red CI pushes (board #113, v3.17.0-v3.17.2) because a
    # stale PS assertion never ran locally on a pwsh-absent box and nobody noticed
    # the gate hadn't actually checked anything. Visible, never blocking: CI covers
    # the PS suites on every push regardless of what this box has installed.
    echo "SKIP: PS suites not run (pwsh absent -- CI covers them)"
  fi
  node scripts/verify.mjs || exit 1
  # Doctrine-mirror + stamp check (machine-local rule homes, not required to exist —
  # see consistency.mjs's resolveMirrorBase: checks this repo, else its parent
  # directory if that's where the umbrella rule trees live, else stays a silent
  # no-op). Kept out of verify.mjs's checkTracked deliberately (CI has no umbrella
  # sibling to find); run here so it still fires on every local commit.
  node scripts/consistency.mjs
  exit $?
fi
exit 0
